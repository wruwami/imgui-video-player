{
  "name": "imgui-video-player",
  "version-string": "0.1.0",
  "description": "Multi-channel hardware-accelerated video player built with Dear ImGui + FFmpeg",
  "dependencies": [
    "glfw3",
    "spdlog",
    "nlohmann-json",
    {
      "name": "ffmpeg",
      "features": [
        "avcodec",
        "avformat",
        "swscale",
        "swresample",
        "nvcodec"
      ]
    }
  ],
  "builtin-baseline": "b42b19a62b63514ed9fa2a81e07ce75e613c83c0"
}
